{
  "name": "@comark/vue",
  "version": "0.9.1",
  "description": "Vue 3 renderer and Nuxt module for Comark. Render Markdown with components at runtime, with streaming support for AI output.",
  "keywords": [
    "ai",
    "ai-chat",
    "comark",
    "components",
    "generative-ui",
    "intelligent-ui",
    "llm",
    "markdown",
    "markdown-renderer",
    "mdc",
    "nuxt",
    "nuxt-module",
    "renderer",
    "streaming",
    "streaming-markdown",
    "vue"
  ],
  "homepage": "https://comark.dev/rendering/vue",
  "bugs": {
    "url": "https://github.com/comarkdown/comark/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/comarkdown/comark.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./vite": "./dist/vite.js",
    "./nuxt": "./dist/nuxt.js",
    "./plugins/*": "./dist/plugins/*.js",
    "./utils": "./dist/utils/index.js",
    "./parse": "./dist/parse.js",
    "./render": "./dist/render.js",
    "./components/*": "./dist/components/*.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "stub": "node ../../scripts/stub.mjs",
    "build": "tsc --removeComments --declaration false && tsc --emitDeclarationOnly",
    "dev": "tsc --watch",
    "test": "vitest run",
    "prepack": "tsc --removeComments --declaration false && tsc --emitDeclarationOnly"
  },
  "dependencies": {
    "comark": "workspace:*"
  },
  "devDependencies": {
    "@nuxt/kit": "catalog:",
    "@nuxt/schema": "catalog:",
    "@vue/compiler-core": "catalog:",
    "@vue/server-renderer": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "vue": "catalog:"
  },
  "peerDependencies": {
    "@nuxt/kit": "^4.6.3",
    "@nuxt/schema": "^4.6.3",
    "beautiful-mermaid": "catalog:",
    "katex": "catalog:",
    "shiki": "catalog:",
    "vue": "^3.5.43"
  },
  "peerDependenciesMeta": {
    "shiki": {
      "optional": true
    },
    "beautiful-mermaid": {
      "optional": true
    },
    "katex": {
      "optional": true
    },
    "@nuxt/kit": {
      "optional": true
    },
    "@nuxt/schema": {
      "optional": true
    }
  }
}
