# Local comark-docs layer checkout for development
# COMARK_DOCS_LAYER=../../comark-docs

# GitHub personal access token (required for private content or to avoid rate limits)
# GITHUB_TOKEN=

# AI Gateway API key for the playground generator and the Ask AI assistant
# (on Vercel, OIDC is used automatically instead)
AI_GATEWAY_API_KEY=

# Gateway model for the Ask AI assistant (default: anthropic/claude-sonnet-5)
# NUXT_ASSISTANT_MODEL=
